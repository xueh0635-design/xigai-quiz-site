{
  "name": "xigai-quiz",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:web": "node ../tools/build-web.cjs",
    "build:sync": "npm run build:web",
    "check:bundle": "node ../tools/build-web.cjs --check",
    "check:content": "node ../tools/validate-content.cjs",
    "copy:web": "node ../tools/copy-web.cjs",
    "sync": "npm run build:web && npm run copy:web && cap sync",
    "test": "node --test tests/*.cjs ../tests/*.test.cjs",
    "test:release": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:database": "node --test ../backend/tests/database.test.mjs",
    "verify": "npm run check:content && npm test && npm run test:release && npm run check:bundle"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.8",
    "supabase": "3.2.0"
  }
}
